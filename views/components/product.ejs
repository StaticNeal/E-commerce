<div class="card">
    <img src="<%= product.image %>" alt="<%= product.name %>">
    <h2>
        <%= product.name %>
    </h2>
    <p>
        <%= product.description %>
    </p>
    <div class="rating">
        <% for (let i=1; i <=5; i++) { %>
            <span class="star">
                <%= i <=product.rating ? '★' : '☆' %>
            </span>
            <% } %>
    </div>
    <p class="price">$<%= product.price.toFixed(2) %>
    </p>
</div>