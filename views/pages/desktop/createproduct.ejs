<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Document</title>

    <link rel="stylesheet" href="/css/generic.css">
    <link rel="stylesheet" href="/css/Desktop/createProduct.css">
    <link rel="stylesheet" href="/css/Desktop/index.css">
</head>

<body>
    <%- include('../../components/navbar') %>


        <div class="components">
            <div class="wrapper-of-all">

                <div id="hero-product">

                    <div class="product-showcase">

                        <input id="product-hero-img-wrapper" type="file" name="hero-img-upload" accept="image/*">

                        <div class="product-other-imgs-wrapper" id="other-images-container">
                            <label class="upload-tile" id="upload-label">
                                <input type="file" id="product-other-img-input" accept="image/*">
                                <span>+</span>
                            </label>

                        </div>

                    </div>



                    <div class="product-description">
                        <div class="basic-details">
                            <div class="product-name-container">
                                <textarea class="product-name-input" id="product-title"
                                    placeholder="Enter product name..."
                                    oninput="this.style.height = '';this.style.height = this.scrollHeight + 'px'"></textarea>
                            </div>
                            <div class="rating">
                                <div class="stars">
                                    <span class="star" data-value="1">★</span>
                                    <span class="star" data-value="2">★</span>
                                    <span class="star" data-value="3">★</span>
                                    <span class="star" data-value="4">★</span>
                                    <span class="star" data-value="5">★</span>
                                </div>
                                <span class="rating-count">(0 reviews)</span>
                            </div>
                            <textarea class="product-price" placeholder="Enter price"></textarea>

                        </div>

                        <textarea class="description" id="product-description" placeholder="Enter description..."
                            oninput="this.style.height = '';this.style.height = this.scrollHeight + 'px'"></textarea>


                        <div class="variants">
                            <button class="expand" type="button">
                                <?xml version="1.0" encoding="utf-8"?><!-- Uploaded to: SVG Repo, www.svgrepo.com, Generator: SVG Repo Mixer Tools -->
                                <svg width="24px" height="24px" viewBox="0 0 24 24" fill="none"
                                    xmlns="http://www.w3.org/2000/svg">
                                    <path
                                        d="M5.70711 9.71069C5.31658 10.1012 5.31658 10.7344 5.70711 11.1249L10.5993 16.0123C11.3805 16.7927 12.6463 16.7924 13.4271 16.0117L18.3174 11.1213C18.708 10.7308 18.708 10.0976 18.3174 9.70708C17.9269 9.31655 17.2937 9.31655 16.9032 9.70708L12.7176 13.8927C12.3271 14.2833 11.6939 14.2832 11.3034 13.8927L7.12132 9.71069C6.7308 9.32016 6.09763 9.32016 5.70711 9.71069Z"
                                        fill="#0F0F0F" />
                                </svg>
                            </button>
                            <h3>Variants:</h3>

                            <ul class="varient-list">
                                <div class="upload-varient" id="upload-varient">
                                    +
                                </div>
                            </ul>

                        </div>


                        <div class="other-details">
                            <div class="quantity">
                                <div class="wrapper">
                                    <h3>Stock:</h3>

                                    <div class="quantity-controls">
                                        <button class="quantity-decrease-btn">-</button>
                                        <div class="quantity-value">1</div>
                                        <button class="quantity-increase-btn">+</button>
                                    </div>
                                </div>

                                <div class="price">$ 99.9</div>
                            </div>
                            <div class="buttons">
                                <button class="buy-now-btn">Buy Now</button>
                                <button class="add-to-cart-btn">Add to Cart</button>
                                <button class="add-to-wishlist-btn">Add to Wishlist</button>
                            </div>

                            <div class="social-links"></div>
                        </div>
                    </div>

                </div>

                <div class="other-details"></div>
                <div class="other-products"></div>
            </div>



            <div class="others">
                <%- include('../../components/cart') %>
                    <%- include('../../components/settings') %>
            </div>
        </div>




        <script src="/js/createProduct.js" defer></script>
        <script src="/js/sidebar.js" defer></script>
        <script src="/js/productView.js" defer></script>



</body>

</html>