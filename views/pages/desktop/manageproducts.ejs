<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>
        <%= title %>
    </title>
    <link rel="stylesheet" href="/css/Desktop/index.css">
    <link rel="stylesheet" href="/css/generic.css">
    <link rel="stylesheet" href="/css/Desktop/manageproducts.css">
</head>

<body>
    <%- include('../../components/navbar') %>
        <main>

            <div class="products-created-container">
                <div class="created-product">
                    <div class="product-image">
                        <img src="/tempimages/vasewhite(1).png" alt="">

                    </div>


                    <div class="product-details">
                        <h2 class="product-name">Vase</h2>
                        <p class="description">
                            lorem ipsum dolor sit amet consectetur adipisicing elit. Soluta libero quaerat officiis
                            quis,
                        </p>

                        <div class="rating" style="padding: 0;">
                            <span class="star">★</span>
                            <span class="star">★</span>
                            <span class="star">★</span>
                            <span class="star">★</span>
                            <span class="star">★</span>
                        </div>

                        <div class="price" style="padding: 0px 0px 0px !important; margin-top: 1.2rem;">$29.99</div>
                    </div>

                </div>
                <div class="components">
                    <div class="products"></div>
                    <div class="others hidden">
                        <%- include('../../components/cart') %>
                            <%- include('../../components/settings') %>
                    </div>
                </div>
        </main>




        <script src="/js/sidebar.js" defer></script>
        <script>
            if (document.readyState === 'loading') {
                document.addEventListener('DOMContentLoaded', () => {
                    const manageProductBtn = document.querySelector('.manage-product-btn');
                    if (manageProductBtn) {
                        manageProductBtn.classList.add('active-menu-item');
                    }
                });
            } else {
                const manageProductBtn = document.querySelector('.manage-product-btn');
                if (manageProductBtn) {
                    manageProductBtn.classList.add('active-menu-item');
                }
            }
        </script>

</body>

</html>